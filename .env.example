# MongoDB Credentials & Sync Configuration
# ----------------------------------------
# Option 1: Standard Sync Endpoint URL (Webhook / Serverless Function / Vercel API)
VITE_MONGODB_SYNC_ENDPOINT=https://your-domain.vercel.app/api/sync-bookmarks

# Option 2: Secret API Key / Bearer Token (Optional)
VITE_MONGODB_API_KEY=your_secret_api_key_here

# Standard MongoDB Connection String (for backend server / serverless function):
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxx.mongodb.net/quran_db?retryWrites=true&w=majority
